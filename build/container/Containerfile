# heron-polyfeed-reader — Tier-A OCI image (the build/container/ story from the RSR template).
#
# The project's canonical image is the root `Containerfile` (scratch runtime, used by
# .github/workflows/zig-ci.yml). This file is the same build on the Chainguard Wolfi runtime
# base the stapeln tooling (build/container/stapeln/ct-build.sh, cerro-torre, svalinn) expects.
# KEEP THE TOOLCHAIN PIN IN STEP WITH /Containerfile, mise.toml and zig-ci.yml: one Zig
# version, one SHA-256, moved together.
#
# Build (engine-agnostic — substitute podman | nerdctl | docker), from the repo root:
#   podman build -t heron:latest -f build/container/Containerfile .
# Run:
#   podman run -v heron-data:/data -v ./heron.json:/config/heron.json:ro heron:latest
# Via the Justfile (auto-detects engine, prefers cerro-torre when present):
#   just container-build

# ============================================================================
# Stage 1: Builder — pinned Zig toolchain, verified by SHA-256
# ============================================================================
FROM docker.io/library/alpine:3 AS builder
ARG ZIG_VERSION=0.17.0
ADD --checksum=sha256:1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026 \
    https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz /tmp/zig.tar.xz
RUN mkdir /opt/zig && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 && rm /tmp/zig.tar.xz
ENV PATH=/opt/zig:$PATH
WORKDIR /build
COPY build.zig build.zig.zon ./
COPY src/ ./src/
COPY vendor/ ./vendor/
RUN zig build test --summary all && zig build -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-musl
# Output: /build/zig-out/bin/heron (static)

# ============================================================================
# Stage 2: Runtime — minimal Wolfi base, non-root, no toolchain
# ============================================================================
#
# Base image: `:latest` is right for a template scaffold (Chainguard rebuilds Wolfi daily). For
# PRODUCTION builds, pin by digest for reproducibility/supply-chain integrity, e.g.:
#   FROM cgr.dev/chainguard/wolfi-base:latest@sha256:<digest>
# (cerro-torre's .ctp signing in build/container/stapeln/ records the resolved digest.)
FROM cgr.dev/chainguard/wolfi-base:latest

# OCI image labels (compatible with cerro-torre .ctp bundle metadata)
LABEL org.opencontainers.image.title="heron-polyfeed-reader" \
      org.opencontainers.image.description="A small local feed reader and site monitor: polls RSS, Atom and RDF feeds and watches sites for downtime, content change and TLS certificate expiry. Zig, vendored SQLite with FTS5, localhost-only web UI." \
      org.opencontainers.image.url="https://github.com/hyperpolymath/heron-polyfeed-reader" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/heron-polyfeed-reader" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      dev.cerrotorre.manifest="build/container/stapeln/manifest.toml" \
      dev.cerrotorre.gatekeeper="build/container/stapeln/.gatekeeper.yaml" \
      dev.stapeln.compose="build/container/stapeln/compose.toml"

# CA roots for HTTPS (heron reads /etc/ssl/certs/ca-certificates.crt). Nothing else: the binary is static.
RUN apk add --no-cache ca-certificates-bundle

# Non-root user. Running as root inside containers is a security anti-pattern.
RUN addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app
COPY --from=builder /build/zig-out/bin/heron /app/heron
COPY build/container/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chown -R appuser:appuser /app

# OPTIONAL (Tier C — stapeln). A pure OCI image does NOT need these baked in:
# svalinn reads .gatekeeper.yaml from a mounted volume (see stapeln/compose.toml),
# and cerro-torre reads manifest.toml at pack time. Uncomment only if you want
# the policy/manifest embedded in the image itself.
# COPY build/container/stapeln/.gatekeeper.yaml /etc/svalinn/gatekeeper.yaml
# COPY build/container/stapeln/manifest.toml /app/manifest.toml

# Data directory for the NDJSON log, SQLite index and lock file (mountable volume). It must exist
# in the image, owned by the runtime user, so a fresh volume inherits writable ownership.
RUN mkdir -p /data /config && chown appuser:appuser /data

# heron's own environment (HERON_CONFIG / HERON_DATA stand in for --config / --data).
ENV HERON_DATA=/data
ENV HERON_CONFIG=/config/heron.json

VOLUME ["/data"]
USER appuser

# The web UI binds 127.0.0.1 by default, which is unreachable from the host. To expose it, set
# "web": {"bind": "0.0.0.0", "allow_non_loopback": true} in heron.json AND publish loopback-only
# on the host side (-p 127.0.0.1:8484:8484); the UI has no authentication.
EXPOSE 8484

# No HEALTHCHECK: the web UI is off unless configured and heron exposes no /health endpoint.
# The daemon exits non-zero on a fatal error, which is the liveness signal an engine restarts on.

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["daemon"]
